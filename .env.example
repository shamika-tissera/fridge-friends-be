# Copy to .env and fill in. Supabase: Project Settings -> Database -> Connection string.
# Leave unset to fall back to local sqlite (sqlite:///./grocery.db).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# LLM used to look up ingredients (any OpenAI-compatible endpoint).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-key-here
LLM_MODEL=openai/gpt-oss-20b

# Notification channel: log (default) or null. See app/notifications.py.
NOTIFICATION_CHANNEL=log
# Seconds before giving up on the LLM (the endpoint sometimes hangs).
LLM_TIMEOUT_SECONDS=90
